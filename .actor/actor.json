{
    "actorSpecification": 1,
    "name": "greenhouse-job-scraper",
    "title": "Greenhouse Job Scraper & API",
    "description": "Scrape Greenhouse ATS jobs via API with department filtering. Pull live roles from Automattic, GitLab and more. Built for job boards and AI agents.",
    "version": "1.2",
    "license": "MIT",
    "dockerfile": "./Dockerfile",
    "readme": "./README.md",
    "categories": ["JOBS"],
    "input": "./INPUT_SCHEMA.json",
    "output": "./output_schema.json",
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "title": "Greenhouse Job Listings",
            "views": {
                "overview": {
                    "title": "Overview",
                    "transformation": {
                        "fields": [
                            "title",
                            "company",
                            "department",
                            "location",
                            "type",
                            "salary",
                            "publishedAt",
                            "postingUrl"
                        ]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "title": { "label": "Job Title", "format": "text" },
                            "company": { "label": "Company", "format": "text" },
                            "department": { "label": "Department", "format": "text" },
                            "location": { "label": "Location", "format": "text" },
                            "type": { "label": "Type", "format": "text" },
                            "salary": { "label": "Salary", "format": "object" },
                            "publishedAt": { "label": "Updated", "format": "date" },
                            "postingUrl": { "label": "URL", "format": "link" }
                        }
                    }
                }
            }
        }
    }
}
